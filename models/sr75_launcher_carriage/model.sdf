<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="sr75_launcher_carriage">

    <static>false</static>

    <!-- Launcher mesh -->
    <link name="launcher_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>200</mass>
        <inertia>
          <ixx>50</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>50</iyy>
          <iyz>0</iyz>
          <izz>50</izz>
        </inertia>
      </inertial>

      <collision name="launcher_rail_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.75 2.90 0.12</size>
          </box>
        </geometry>
      </collision>

      <visual name="launcher_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://sr75_launch_stack_with_controls/meshes/SR75_LAUNCHER.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="launcher_world_joint" type="fixed">
      <parent>world</parent>
      <child>launcher_link</child>
    </joint>

    <!-- F22-GZ-J: rail_carriage_link is a small, low-mass body that rides
         the rail via the prismatic joint. It carries no visual/collision
         of its own (the launcher visual mesh already represents the
         rail); its only job is to be the DetachableJoint's parent_link,
         so the separate UAV model (sr75_uav_release) can be rigidly
         attached to it pre-launch and cleanly detached at release. -->
    <link name="rail_carriage_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
    </link>

    <!-- F22-GZ-Q: promotes the F22-GZ-O low-loss long-rail mechanism.
         Rail axis is local Y, extended from the original 2.90m (+-1.45m,
         20deg elevation) to a 17.5m one-directional travel, needed to
         reach a controllable release speed (F22-GZ-M found 30 m/s still
         diverges, 45 m/s comfortably stable).

         The prelaunch lock and the in-flight rail resistance used to be
         the same friction/damping pair (F22-GZ-F..N); that conflated two
         different jobs: damping is velocity-proportional, so a value
         negligible at low speed becomes a large drag at higher speed
         (F22-GZ-N: friction=600/damping=50 gave only 35.87 m/s against a
         45 m/s target at 17.06m, a ~20% shortfall). F22-GZ-O separated
         them: the prelaunch lock is now the joint's own LOWER LIMIT
         (lower=0.0), a hard mechanical stop the carriage's rest position
         sits exactly against; gravity's along-rail component just
         pushes it into the stop, no friction needed. With the stop doing
         the holding, friction=0 and damping=1 (negligible: ~45N at
         release speed vs 5800N thrust, kept only as a mild numerical
         stabilizer) give a genuinely low-loss rail. Measured result:
         release at along=17.059m, speed=43.85 m/s (predicted ~45.01 m/s
         analytically; the ~2.6% shortfall is the residual damping=1
         term), cross drift ~0.00013m, attitude unchanged at release. -->
    <joint name="rail_slider_joint" type="prismatic">
      <parent>launcher_link</parent>
      <child>rail_carriage_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>17.5</upper>
        </limit>
        <dynamics>
          <friction>0</friction>
          <damping>1</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Native DetachableJoint: rigidly attaches sr75_uav_release::wing to
         rail_carriage_link at load, detachable at runtime via
         /sr75_launcher_carriage/release/detach. This is the mechanism
         that lets the UAV be released cleanly before the rail's hard
         travel limit, instead of trying (and failing, see F22-GZ-G) to
         runtime-delete the prismatic joint itself. -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>rail_carriage_link</parent_link>
      <child_model>sr75_uav_release</child_model>
      <child_link>wing</child_link>
      <detach_topic>/sr75_launcher_carriage/release/detach</detach_topic>
      <output_topic>/sr75_launcher_carriage/release/state</output_topic>
    </plugin>

  </model>
</sdf>
