<?xml version="1.0"?>
<model>
  <name>sr75_launcher_carriage</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>SR75</name>
  </author>
  <description>
    F22-GZ-J: launcher fixed to world, with a rail_carriage_link connected
    by a prismatic joint along the rail axis. The carriage carries a
    DetachableJoint attachment point for a separate UAV model
    (sr75_uav_release), allowing a guided rail phase followed by a clean
    release without hitting the rail's hard travel limit. Validated in
    scratch as F22-GZ-F through F22-GZ-I; this promotes that architecture
    to a tracked model. The older single-model sr75_launch_stack_with_
    controls is preserved unchanged.
  </description>
</model>
