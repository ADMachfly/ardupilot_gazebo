      <!-- ==================== SR-75 DEBUG VISUAL MARKERS INSIDE WING LINK ==================== -->
      <!-- DEBUG: left elevon hinge axis marker (yellow rod) -->
          <visual name="debug_left_flap_hinge_axis">
  <!-- YELLOW: left elevon hinge line, just ahead of left flap -->
  <pose>0.55 0.265 0.035 0 0 0.20</pose>
  <geometry>
    <box>
      <size>0.54 0.018 0.018</size>
    </box>
  </geometry>
  <material>
    <ambient>1 1 0 1</ambient>
    <diffuse>1 1 0 1</diffuse>
  </material>
</visual>

      <!-- DEBUG: right elevon hinge axis marker (yellow rod) -->
          <visual name="debug_right_flap_hinge_axis">
  <!-- YELLOW: right elevon hinge line, just ahead of right flap -->
  <pose>-0.55 0.265 0.035 0 0 -0.20</pose>
  <geometry>
    <box>
      <size>0.54 0.018 0.018</size>
    </box>
  </geometry>
  <material>
    <ambient>1 1 0 1</ambient>
    <diffuse>1 1 0 1</diffuse>
  </material>
</visual>
      <!-- ==================== END SR-75 DEBUG VISUAL MARKERS ==================== -->

</link>
    <link name="flap_left">
  <!-- Left elevon/flap debug link: outer-left trailing edge -->
  <pose>0.55 0.34 0.018 0 0 0</pose>

  <inertial>
    <pose>0 0 0 0 0 0.20</pose>
    <mass>0.1</mass>
    <inertia>
      <ixx>0.000102319</ixx>
      <ixy>0</ixy>
      <iyy>0.00334417</iyy>
      <ixz>0</ixz>
      <iyz>0</iyz>
      <izz>0.003446072</izz>
    </inertia>
  </inertial>

  <!-- RED: left elevon/flap surface -->
  <visual name="debug_flap_left_visual">
    <pose>0 0 0 0 0 0.20</pose>
    <geometry>
      <box>
        <size>0.50 0.14 0.018</size>
      </box>
    </geometry>
    <material>
      <ambient>1 0 0 1</ambient>
      <diffuse>1 0 0 1</diffuse>
    </material>
  </visual>

  <collision name="collision">
    <pose>0 0 0 0 0 0.20</pose>
    <geometry>
      <box>
        <size>0.50 0.14 0.010</size>
      </box>
    </geometry>
  </collision>
</link>
    <link name="flap_right">
  <!-- Right elevon/flap debug link: outer-right trailing edge -->
  <pose>-0.55 0.34 0.018 0 0 0</pose>

  <inertial>
    <pose>0 0 0 0 0 -0.20</pose>
    <mass>0.1</mass>
    <inertia>
      <ixx>0.000102319</ixx>
      <ixy>0</ixy>
      <iyy>0.00334417</iyy>
      <ixz>0</ixz>
      <iyz>0</iyz>
      <izz>0.003446072</izz>
    </inertia>
  </inertial>

  <!-- GREEN: right elevon/flap surface -->
  <visual name="debug_flap_right_visual">
    <pose>0 0 0 0 0 -0.20</pose>
    <geometry>
      <box>
        <size>0.50 0.14 0.018</size>
      </box>
    </geometry>
    <material>
      <ambient>0 1 0 1</ambient>
      <diffuse>0 1 0 1</diffuse>
    </material>
  </visual>

  <collision name="collision">
    <pose>0 0 0 0 0 -0.20</pose>
    <geometry>
      <box>
        <size>0.50 0.14 0.010</size>
      </box>
    </geometry>
  </collision>
</link>

    <!-- <joint name="propeller_joint" type="revolute">
      <parent>wing</parent>
      <child>propeller</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <dynamics>
          <damping>0.002</damping>
        </dynamics>
      </axis>
    </joint> -->

    <joint name="flap_left_joint" type="revolute">
      <parent>wing</parent>
      <child>flap_left</child>
      <pose>0 -0.04 0 0 0 0</pose>
      <axis>
        <xyz>1 0.330321014 0</xyz>
        <limit>
          <lower>-0.524</lower>
          <upper>0.524</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="flap_right_joint" type="revolute">
      <parent>wing</parent>
      <child>flap_right</child>
      <pose>0 -0.04 0 0 0 0</pose>
      <axis>
        <xyz>1 -0.330321014 0</xyz>
        <limit>
          <lower>-0.524</lower>
          <upper>0.524</upper>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- sensors -->
    <link name='imu_link'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <pose degrees="true">0 0 0 180 0 -90</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>
    <joint name='imu_joint' type='revolute'>
      <child>imu_link</child>
      <parent>wing</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== ADD LOCATION 3 HERE ==================== -->

<!-- SR-75 Left Engine (virtual jet thrust point) -->
<link name="left_engine_link">
  <!-- Left rear engine debug link -->
  <pose>0.18 0.55 0.055 0 0 0</pose>

  <inertial>
    <mass>0.001</mass>
    <inertia>
      <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
      <iyy>0.000001</iyy><iyz>0</iyz>
      <izz>0.000001</izz>
    </inertia>
  </inertial>

  <!-- BLUE: left engine block -->
  <visual name="debug_left_engine_block">
    <pose>0 0 0 0 0 0</pose>
    <geometry>
      <box>
        <size>0.10 0.22 0.11</size>
      </box>
    </geometry>
    <material>
      <ambient>0 0 1 1</ambient>
      <diffuse>0 0 1 1</diffuse>
    </material>
  </visual>

  <!-- CYAN: left thrust direction, forward along -Y -->
  <visual name="debug_left_engine_thrust_direction">
    <pose>0 0.20 0 1.5708 0 0</pose>
    <geometry>
      <cylinder>
        <radius>0.012</radius>
        <length>0.32</length>
      </cylinder>
    </geometry>
    <material>
      <ambient>0 1 1 1</ambient>
      <diffuse>0 1 1 1</diffuse>
    </material>
  </visual>
</link>

<!-- SR-75 Right Engine (virtual jet thrust point) -->
<link name="right_engine_link">
  <!-- Right rear engine debug link -->
  <pose>-0.18 0.55 0.055 0 0 0</pose>

  <inertial>
    <mass>0.001</mass>
    <inertia>
      <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
      <iyy>0.000001</iyy><iyz>0</iyz>
      <izz>0.000001</izz>
    </inertia>
  </inertial>

  <!-- MAGENTA: right engine block -->
  <visual name="debug_right_engine_block">
    <pose>0 0 0 0 0 0</pose>
    <geometry>
      <box>
        <size>0.10 0.22 0.11</size>
      </box>
    </geometry>
    <material>
      <ambient>1 0 1 1</ambient>
      <diffuse>1 0 1 1</diffuse>
    </material>
  </visual>

  <!-- CYAN: right thrust direction, forward along -Y -->
  <visual name="debug_right_engine_thrust_direction">
    <pose>0 0.20 0 1.5708 0 0</pose>
    <geometry>
      <cylinder>
        <radius>0.012</radius>
        <length>0.32</length>
      </cylinder>
    </geometry>
    <material>
      <ambient>0 1 1 1</ambient>
      <diffuse>0 1 1 1</diffuse>
    </material>
  </visual>
</link>

<!-- Fix engine links rigidly to main wing body -->
<joint name="left_engine_joint" type="fixed">
  <parent>wing</parent>
  <child>left_engine_link</child>
</joint>

<joint name="right_engine_joint" type="fixed">
  <parent>wing</parent>
  <child>right_engine_link</child>
</joint>

  </model>
</sdf>
