<?xml version="1.0" ?>
<!--
  SR-75 Skyreaper — Physics model (sr75_zephyr_physics/model.sdf)
  Phase 8 — Axis / inertia / collision corrected

  Body-frame convention (used consistently throughout this file):
    +X = left  wing
    -X = right wing
    -Y = nose  / forward / thrust direction
    +Y = tail  / rear   / engine nozzles
    +Z = up
    -Z = down

  Changes from previous version:
    1. REMOVED  propeller link, propeller collisions (blade1/blade2) — jet aircraft
    2. FIXED    body collision size: was (1.50 0.35 0.35), now (0.35 1.50 0.35)
                length must be on Y-axis, not X-axis
    3. FIXED    inertia: ixx and iyy were swapped
                X = wingspan ~1.6 m  => ixx = 19.0
                Y = length   ~1.53 m => iyy = 20.5
    4. FIXED    nose gear pose: was (0.55 0 -0.28) = left side
                                now (0   -0.55 -0.28) = forward/nose
    5. FIXED    main gear poses: were (-0.35 ±0.35 -0.28)
                                 now  (±0.35 +0.35 -0.28) = aft, left/right
    6. FIXED    engine link poses:
                left  was (-0.55 -0.25 0), now (+0.25 +0.55 0) = left-rear
                right was (-0.55 +0.25 0), now (-0.25 +0.55 0) = right-rear
-->

<sdf version="1.9">
  <model name="zephyr">
    <link name="wing">

    <!-- SR-75 downward rangefinder placeholder -->
<sensor name="sr75_down_rangefinder" type="gpu_lidar">
  <pose>0 0 -0.25 0 1.5708 0</pose>
  <always_on>1</always_on>
  <update_rate>20</update_rate>
  <lidar>
    <scan>
      <horizontal>
        <samples>1</samples>
        <resolution>1</resolution>
        <min_angle>0</min_angle>
        <max_angle>0</max_angle>
      </horizontal>
      <vertical>
        <samples>1</samples>
        <resolution>1</resolution>
        <min_angle>0</min_angle>
        <max_angle>0</max_angle>
      </vertical>
    </scan>
    <range>
      <min>0.2</min>
      <max>50</max>
      <resolution>0.01</resolution>
    </range>
  </lidar>
</sensor>

<inertial>
  <!-- SR-75 inertial model, Phase 2 -->
  <!-- Dimensions used: wingspan b=1.6 m, chord c=0.625 m, approx length=1.53 m, height=0.65 m -->
  <!-- CGOffset from SR-75 JSON: [-0.15, 0.0, -0.05] -->
  <pose>-0.15 0 -0.05 0 0 0</pose>

  <mass>82.5</mass>

  <inertia>
    <!-- Approx box inertia: mass=82.5 kg, X=1.53 m, Y=1.6 m, Z=0.65 m -->
  <ixx>19.0</ixx>
  <ixy>0</ixy>
  <ixz>0</ixz>
  <iyy>20.5</iyy>
  <iyz>0</iyz>
  <izz>33.7</izz>
  </inertia>
</inertial>
<visual name="sr75_skyreaper_visual">
  <!-- STL exported in millimeters; Gazebo uses meters -->
  <!-- CAD center after mm to m: X=0.765, Y=0.936, Z=0.367 -->
  <!-- Rotated 180 deg around Z so STL nose (originally +Y in STL coords)
       faces body -Y (aerodynamic forward).  Offset recalculated so CAD
       center still lands on the link origin:
         T_new = -R_z(pi) * CAD_center = (0.765, 0.936, -0.367) -->
  <pose>0.765 0.936 -0.367 0 0 3.14159</pose>

  <geometry>
    <mesh>
      <uri>model://sr75_zephyr_physics/meshes/Skyreaper_Base_model.STL</uri>
      <scale>0.001 0.001 0.001</scale>
    </mesh>
  </geometry>

  <material>
    <ambient>0.35 0.35 0.35 1</ambient>
    <diffuse>0.35 0.35 0.35 1</diffuse>
    <specular>0.1 0.1 0.1 1</specular>
  </material>
</visual>

<collision name="sr75_body_collision">
  <!-- Simple SR-75 collision box: length, wingspan, height -->
  <pose>0 0 0.05 0 0 0</pose>
  <geometry>
    <box>
      <size>0.35 1.50 0.35</size>
    </box>
  </geometry>
  <surface>
    <friction>
      <ode>
        <mu>0.4</mu>
        <mu2>0.4</mu2>
      </ode>
    </friction>
    <contact>
      <ode>
        <kp>100000</kp>
        <kd>10</kd>
        <max_vel>0.5</max_vel>
        <min_depth>0.001</min_depth>
      </ode>
    </contact>
  </surface>
</collision>

<collision name="nose_gear_collision">
  <pose>0 -0.55 -0.28 0 0 0</pose>
  <geometry>
    <sphere>
      <radius>0.045</radius>
    </sphere>
  </geometry>
  <surface>
    <friction>
      <ode>
        <mu>0.05</mu>
        <mu2>0.05</mu2>
      </ode>
    </friction>
    <contact>
      <ode>
        <kp>50000</kp>
        <kd>5</kd>
        <max_vel>0.2</max_vel>
        <min_depth>0.001</min_depth>
      </ode>
    </contact>
  </surface>
</collision>

<collision name="left_main_gear_collision">
  <pose>0.35 0.35 -0.28 0 0 0</pose>
  <geometry>
    <sphere>
      <radius>0.055</radius>
    </sphere>
  </geometry>
  <surface>
    <friction>
      <ode>
        <mu>0.05</mu>
        <mu2>0.05</mu2>
      </ode>
    </friction>
    <contact>
      <ode>
        <kp>50000</kp>
        <kd>5</kd>
        <max_vel>0.2</max_vel>
        <min_depth>0.001</min_depth>
      </ode>
    </contact>
  </surface>
</collision>

<collision name="right_main_gear_collision">
  <pose>-0.35 0.35 -0.28 0 0 0</pose>
  <geometry>
    <sphere>
      <radius>0.055</radius>
    </sphere>
  </geometry>
  <surface>
    <friction>
      <ode>
        <mu>0.05</mu>
        <mu2>0.05</mu2>
      </ode>
    </friction>
    <contact>
      <ode>
        <kp>50000</kp>
        <kd>5</kd>
        <max_vel>0.2</max_vel>
        <min_depth>0.001</min_depth>
      </ode>
    </contact>
  </surface>
</collision>

<!-- Add camera here, before closing wing link -->
