<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="sr75_launch_stack_with_controls">

    <static>true</static>

    <!-- Main UAV mesh -->
    <link name="wing">
      <pose>0 0 0 0 0 0</pose>

      <visual name="sr75_uav_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://sr75_launch_stack_with_controls/meshes/SR75_UAV.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- Launcher mesh -->
    <link name="launcher_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="launcher_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://sr75_launch_stack_with_controls/meshes/SR75_LAUNCHER.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- RATO mesh -->
    <link name="rato_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="rato_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://sr75_launch_stack_with_controls/meshes/SR75_RATO.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!--
    ============================================================
    FLAPS / AILERONS / HINGE DEBUG VISUALS DISABLED FOR NOW

    Disabled blocks:
      - flap_left
      - flap_right
      - debug_left_hinge
      - debug_right_hinge

    Reason:
      Visual alignment of these placeholders will be handled later.
      Current priority is:
        1. UAV + launcher + RATO alignment
        2. engine placeholder alignment
        3. later add proper aerodynamic/control-surface links
    ============================================================
    -->

    <!-- BLUE: left engine block -->
    <link name="left_engine_link">
      <pose>0.100 0.030 -0.130 3.141578 1.320793 -1.570811</pose>

      <visual name="debug_left_engine_block">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.10 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>

      <!-- CYAN: left thrust rod moved outside the block -->
      <visual name="debug_left_engine_thrust_direction">
        <pose>0.220 0 0 3.141593 1.570793 3.141593</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.32</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 1 1 1</ambient>
          <diffuse>0 1 1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- MAGENTA: right engine block -->
    <link name="right_engine_link">
      <pose>-0.100 0.030 -0.130 3.141578 1.320793 -1.570811</pose>

      <visual name="debug_right_engine_block">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.10 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 1 1</ambient>
          <diffuse>1 0 1 1</diffuse>
        </material>
      </visual>

      <!-- CYAN: right thrust rod moved outside the block -->
      <visual name="debug_right_engine_thrust_direction">
        <pose>0.220 0 0 3.141593 1.570793 3.141593</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.32</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 1 1 1</ambient>
          <diffuse>0 1 1 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>