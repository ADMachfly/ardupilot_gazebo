<?xml version="1.0"?>
<model>
  <name>sr75_uav_release</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>SR75</name>
  </author>
  <description>
    F22-GZ-J: standalone UAV body (wing + RATO + engine placeholders +
    IMU), attached to sr75_launcher_carriage's rail carriage via a
    DetachableJoint at spawn. Has no collision geometry of its own -- the
    prismatic rail joint plus DetachableJoint fully constrain it during
    the guided phase, so no contact-based rail support is needed (see
    F22-GZ-D/E/F for why passive contact alone was insufficient at a real
    launch angle).
  </description>
</model>
