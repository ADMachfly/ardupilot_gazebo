<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="sr75_uav_release">

    <static>false</static>

    <!-- Main UAV mesh -->
    <link name="wing">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>-0.15 0 -0.05 0 0 0</pose>
        <mass>82.5</mass>
        <inertia>
          <ixx>19.0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>20.5</iyy>
          <iyz>0</iyz>
          <izz>33.7</izz>
        </inertia>
      </inertial>

      <visual name="sr75_uav_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://sr75_launch_stack_with_controls/meshes/SR75_UAV.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- RATO mesh -->
    <link name="rato_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.04</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.08</iyy>
          <iyz>0</iyz>
          <izz>0.08</izz>
        </inertia>
      </inertial>

      <collision name="rato_collision">
        <pose>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="rato_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://sr75_launch_stack_with_controls/meshes/SR75_RATO.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <joint name="rato_to_wing_joint" type="fixed">
      <parent>wing</parent>
      <child>rato_link</child>
    </joint>

    <!-- BLUE: left engine block -->
    <link name="left_engine_link">
      <pose>0.100 0.030 -0.130 3.141578 1.320793 -1.570811</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>

      <visual name="debug_left_engine_block">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.10 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>

      <visual name="debug_left_engine_thrust_direction">
        <pose>0.220 0 0 3.141593 1.570793 3.141593</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.32</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 1 1 1</ambient>
          <diffuse>0 1 1 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_engine_joint" type="fixed">
      <parent>wing</parent>
      <child>left_engine_link</child>
    </joint>

    <!-- MAGENTA: right engine block -->
    <link name="right_engine_link">
      <pose>-0.100 0.030 -0.130 3.141578 1.320793 -1.570811</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>

      <visual name="debug_right_engine_block">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.10 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 1 1</ambient>
          <diffuse>1 0 1 1</diffuse>
        </material>
      </visual>

      <visual name="debug_right_engine_thrust_direction">
        <pose>0.220 0 0 3.141593 1.570793 3.141593</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.32</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 1 1 1</ambient>
          <diffuse>0 1 1 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="right_engine_joint" type="fixed">
      <parent>wing</parent>
      <child>right_engine_link</child>
    </joint>

    <link name="imu_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>

      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
      </sensor>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent>wing</parent>
      <child>imu_link</child>
    </joint>

  </model>
</sdf>
